package net.pot37.hungerbarmod;

import net.fabricmc.api.ClientModInitializer;
import net.fabricmc.fabric.api.client.hud.v1.HudRenderCallback;
import net.fabricmc.fabric.api.event.player.UseItemCallback;
import net.minecraft.item.Item;
import net.minecraft.item.ItemStack;
import net.minecraft.item.Items;
import net.minecraft.util.ActionResult;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import java.util.Map;

public class HungerBarMod implements ClientModInitializer {
    public static final String MOD_ID = "hunger-bar-mod";
    public static final Logger LOGGER = LoggerFactory.getLogger(MOD_ID);

    private static Item lastFoodItem = Items.AIR;

    private static final Map<Item, Integer> FOOD_COLORS = Map.of(
        Items.APPLE, 0xFF8FDE57,
        Items.BREAD, 0xFFE9D77A,
        Items.COOKED_BEEF, 0xFFB75A49,
        Items.COOKED_PORKCHOP, 0xFFD77C72,
        Items.COOKED_CHICKEN, 0xFFE7B570,
        Items.COOKED_COD, 0xFF6FB7FF,
        Items.COOKED_SALMON, 0xFFFFB780,
        Items.CARROT, 0xFFFF9C2A,
        Items.GOLDEN_CARROT, 0xFF9CFF69,
        Items.GOLDEN_APPLE, 0xFFFFD75C,
        Items.ENCHANTED_GOLDEN_APPLE, 0xFFFFD75C,
        Items.BAKED_POTATO, 0xFFE6D29C,
        Items.MELON_SLICE, 0xFF83D743,
        Items.PUMPKIN_PIE, 0xFFE1B36A,
        Items.COOKED_MUTTON, 0xFFD2897A,
        Items.COOKED_RABBIT, 0xFFD4A88A,
        Items.CAKE, 0xFFF5F2E8,
        Items.BEETROOT, 0xFFAE2955,
        Items.BEETROOT_SOUP, 0xFFB6729A,
        Items.SUSPICIOUS_STEW, 0xFF8AAE67,
        Items.MUSHROOM_STEW, 0xFFB38B5A
    );

    @Override
    public void onInitializeClient() {
        HudRenderCallback.EVENT.register(HungerBarRenderer::render);

        UseItemCallback.EVENT.register((player, world, hand) -> {
            if (!world.isClient) {
                return ActionResult.PASS;
            }

            ItemStack stack = player.getStackInHand(hand);
            if (stack == null || stack.isEmpty()) {
                return ActionResult.PASS;
            }

            Item item = stack.getItem();
            if (stack.isFood()) {
                lastFoodItem = item;
            }

            return ActionResult.PASS;
        });

        LOGGER.info("Hunger Bar Mod initialized");
    }

    public static Integer getCurrentFoodColor() {
        return FOOD_COLORS.get(lastFoodItem);
    }

    public static void resetFoodColor() {
        lastFoodItem = Items.AIR;
    }
}
